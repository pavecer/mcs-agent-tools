# Environment — dev mode (two ports)
REFLEX_ENV=dev
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Environment — prod mode (single port; set REFLEX_ENV=prod)
# REFLEX_ENV=prod
# PORT=2009

# Authentication — comma-separated username:password pairs
# Leave empty to disable authentication entirely
# USERS=admin:secret123,analyst:pass456
USERS=admin:CHANGE_ME

# Log level
LOG_LEVEL=INFO

# OpenAI API configuration (optional)
# Direct OpenAI API (default):
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_STORE_REQUESTS=true    # Optional: store completions so they appear in OpenAI Logs UI
#
# Optional custom/compatible endpoint (including Azure OpenAI):
# OPENAI_BASE_URL=https://my-resource.openai.azure.com/
# OPENAI_MODEL=my-deployment-name

# Multi-model comparison (optional)
# true  = expose Live Comparison action in UI
# simulated (default) = one real model simulates other models (lower quota/cost)
# real = call each model directly (higher quota/cost)
# MCS_ENABLE_MODEL_COMPARISON=true
# MCS_COMPARISON_MODE=simulated
# MCS_COMPARISON_MODELS=gpt-4o-mini,gpt-4o

# LLM-powered eval generation (optional)
# When OPENAI_API_KEY is set, the Evals tab uses an LLM to generate richer
# test scenarios instead of the built-in rule-based templates.
