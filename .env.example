# Environment — dev mode (two ports)
REFLEX_ENV=dev
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Environment — prod mode (single port; set REFLEX_ENV=prod)
# REFLEX_ENV=prod
# PORT=2009

# Authentication — comma-separated username:password pairs
# Leave empty to disable authentication entirely
# USERS=admin:secret123,analyst:pass456
USERS=admin:CHANGE_ME

# Log level
LOG_LEVEL=INFO

# Multi-model comparison (optional)
# Set MCS_ENABLE_MODEL_COMPARISON=true and provide an OpenAI API key to run
# live sample queries against multiple models for comparison.
# Warning: enabling this incurs OpenAI API usage costs.
# MCS_ENABLE_MODEL_COMPARISON=false
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://my-resource.openai.azure.com/   # Optional custom/compatible endpoint
# OPENAI_MODEL=my-deployment-name                         # Used when OPENAI_BASE_URL is set
# MCS_COMPARISON_MODELS=gpt-4o,gpt-4o-mini               # Optional comma-separated override list

# LLM-powered eval generation (optional)
# When OPENAI_API_KEY is set, the Evals tab uses an LLM to generate richer
# test scenarios instead of the built-in rule-based templates.
# Warning: enabling this incurs OpenAI API usage costs.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://my-resource.openai.azure.com/   # Azure OpenAI endpoint (optional)
# OPENAI_MODEL=gpt-4o-mini                                # default: gpt-4o-mini
