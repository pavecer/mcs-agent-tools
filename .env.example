# Environment — dev mode (two ports)
REFLEX_ENV=dev
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Environment — prod mode (single port; set REFLEX_ENV=prod)
# REFLEX_ENV=prod
# PORT=2009

# Authentication — comma-separated username:password pairs
# Leave empty to disable authentication entirely
# USERS=admin:secret123,analyst:pass456
USERS=admin:CHANGE_ME

# Log level
LOG_LEVEL=INFO

# Multi-model comparison (optional)
# Set MCS_ENABLE_MODEL_COMPARISON=true and provide an OpenAI API key to run
# live sample queries against multiple models for comparison.
# Warning: enabling this incurs OpenAI API usage costs.
# MCS_ENABLE_MODEL_COMPARISON=false
# OPENAI_API_KEY=sk-...
